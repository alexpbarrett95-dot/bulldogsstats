{
  // Cloudflare deploys the current GitHub main branch with this Worker configuration.
  // Static interface assets are bundled with each deployment.
  // Game-summary reporting uses the current production bundle.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulldogsstats",
  "account_id": "0fc5a271f42c4d7c2b4354f5a8e2e0da",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bulldogsstats-db",
      "database_id": "1d176891-60a4-4f48-857a-2a86dd0eba4b",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}

